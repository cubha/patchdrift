# patchgap 로컬 실행용 환경변수 예시 — 값은 채우지 말고 `.env`로 복사한 뒤 채운다.
# 검증 스키마: src/pipeline/shared/env.ts (zod). 값은 어떤 로그·커밋·문서에도 절대 남기지 않는다.

# 필수 — Riot Developer Portal(Personal API Key, 24h 만료). league-v4/match-v5 조회에 사용.
# 리밋: 20req/1s, 100req/120s(2단 bottleneck 체이닝, src/pipeline/collect/riot-client.ts).
# 재판매·유료화 기능 금지, 아레나/무작위 총력전 통계 생성 금지(라이엇 terms, F7).
RIOT_API_KEY=

# 선택 — Claude API(F4 2단 LLM 매칭·S3 요약문, model="claude-sonnet-5"). 비우면
# scripts/run-match.ts --no-llm과 동일하게 2단 추론을 스킵하고 1단 결정론 판정만 기록한다
# (무근거 회색 원칙 — 크래시하지 않고 근거 없는 문장만 회색으로 떨어진다).
ANTHROPIC_API_KEY=

# 선택 — Discord 웹훅 URL(F6 브리핑 전송, scripts/run-notify.ts). 비우면 브리핑 전송 단계를
# 건너뛴다. GitHub Actions에서는 이 값을 레포 Secrets(DISCORD_WEBHOOK_URL)로 등록한다(README
# "운영 절차" 참고) — 이 파일이나 워크플로우 로그에 실제 값이 노출되지 않도록 항상 secrets로만 주입.
DISCORD_WEBHOOK_URL=

# pipeline:match(run-match.ts)의 --from/--to 기본값(CLI 인자로 덮어쓰기 가능). PatchId 표기는
# 패치노트 원문 표기("26.NN") — Data Dragon/gameVersion의 "16.NN"과 다르다(패치 매핑,
# src/pipeline/shared/patches.ts 참고).
PATCH_FROM=26.16
PATCH_TO=26.17
